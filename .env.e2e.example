# Credentials the Playwright suite logs in with. Copy to .env.e2e (gitignored)
# and fill in the values of YOUR local install — the suite reads .env.e2e
# automatically, so no env vars need to be typed on each run.
#
#   cp .env.e2e.example .env.e2e
#
# They must match the account in the database (npm run set-admin-email /
# npm run reset-password) and MANAGER_CODE_HASH in .env.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_MANAGER_CODE=
